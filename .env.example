# Harbor Mail deployment secrets (read by docker-compose.yml).
# Copy to .env and fill in real values — never commit the real file.

# 32+ byte HS256 secret for JWT signing/verification.
# Generate: openssl rand -base64 48
HARBOR_JWT_SECRET=change-me-use-32-random-bytes

# Postgres password for the harbor user.
# The API container reads this to connect; keep it aligned with whatever
# password Postgres was initialised with.
POSTGRES_PASSWORD=harbor

# Public origin the frontend is served from (used by CORS + auth email links).
HARBOR_PUBLIC_ORIGIN=http://localhost:5174
HARBOR_CORS_ORIGINS=http://localhost:5174

# Auth lifecycle defaults (safe unless overridden):
#   HARBOR_REQUIRE_VERIFICATION=true   # email verification before sign-in
#   HARBOR_DEV_RETURN_TOKEN_LINKS=0    # MUST be 0 in production once SMTP exists
#   HARBOR_COOKIE_SECURE=false         # true once TLS is on
#   HARBOR_JWT_ACCESS_TTL_SECS=900
#   HARBOR_JWT_REFRESH_TTL_SECS=2592000

# Stalwart mail service (WS2):
#   HARBOR_MAIL_ADMIN_PASSWORD=       # admin pin; also used by api provisioning
#   HARBOR_MAIL_DEFAULT_DOMAIN=       # primary mail domain (default crescentsphere.com)
#   HARBOR_MAIL_ACCOUNT_QUOTA_BYTES=  # per-mailbox quota in bytes (default 2 GiB)