# Harbor Mail frontend configuration
#
# The UI runs two modes:
#   - local (default): all services back onto localStorage; no backend required
#   - remote: services call the JSON API (HTTP/axum or the bundled node demo
#     server) via /api and use real cookies/auth.

# Set to "remote" to talk to a backend instead of localStorage.
VITE_MAIL_BACKEND=local

# Base URL of the JSON API. The dev server also proxies /api to this target.
VITE_API_URL=http://localhost:8000