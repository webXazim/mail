# CS Mail production configuration
# Runtime location: /opt/cs-mail/.env.production
# Ownership: root:root   Permissions: 0600
# NEVER commit the live file to GitHub.
#
# Current shared-VPS topology:
#   Web:  https://mail.crescentsphere.com -> Messenger Docker Nginx :443
#   API:  127.0.0.1:18080 -> Rust/Axum (private)
#   Admin:127.0.0.1:18081 -> localhost/SSH tunnel only
#   Mail: smtp.crescentsphere.com -> shared Stalwart :25/:465/:993
#
# Values marked REQUIRED OPERATOR INPUT are the only normal first-deploy values
# that cannot be safely generated or inferred by CS Mail.

# =============================================================================
# 1. CS MAIL-OWNED SECRETS (bootstrap-vps.sh generates these once)
# =============================================================================
POSTGRES_PASSWORD=
CS_MAIL_JWT_SECRET=
CS_MAIL_DELIVERY_EVENT_SECRET=
CS_MAIL_PROVISIONING_KEY=
CS_MAIL_TOTP_KEY=

# =============================================================================
# 2. DATABASE / APPLICATION SECURITY
# =============================================================================
POSTGRES_USER=csmail
POSTGRES_DB=csmail
CS_MAIL_DB_MAX_CONNECTIONS=10
CS_MAIL_JWT_ACCESS_TTL_SECS=900
CS_MAIL_JWT_REFRESH_TTL_SECS=2592000
CS_MAIL_COOKIE_SECURE=true
CS_MAIL_REQUIRE_VERIFICATION=true
CS_MAIL_DEV_RETURN_TOKEN_LINKS=false
CS_MAIL_LOG_FORMAT=json
CS_MAIL_LISTEN_ADDR=0.0.0.0:8080

# =============================================================================
# 3. PUBLIC WEB APPLICATION / SHARED NGINX
# =============================================================================
CS_MAIL_PUBLIC_ORIGIN=https://mail.crescentsphere.com
CS_MAIL_CORS_ORIGINS=https://mail.crescentsphere.com
CS_MAIL_WEB_HOST=mail.crescentsphere.com
CS_MAIL_API_HOST_PORT=18080
CS_MAIL_ADMIN_HOST_PORT=18081
CS_MAIL_REQUIRE_PUBLIC_HTTPS_HEALTH=true
# Shared-Nginx site locations. These do not replace or modify other vhosts.
CS_MAIL_NGINX_SITE=/etc/nginx/sites-available/cs-mail.conf
CS_MAIL_NGINX_LINK=/etc/nginx/sites-enabled/cs-mail.conf
# Let's Encrypt web certificate for the CS Mail web hostname.
CS_MAIL_WEB_TLS_CERT=/etc/letsencrypt/live/mail.crescentsphere.com/fullchain.pem
CS_MAIL_WEB_TLS_KEY=/etc/letsencrypt/live/mail.crescentsphere.com/privkey.pem
CS_MAIL_ACME_WEBROOT=/var/www/letsencrypt
# REQUIRED OPERATOR INPUT: normal email address for Let's Encrypt notices.
CS_MAIL_LETSENCRYPT_EMAIL=

# =============================================================================
# 4. PRIVATE DOCKER NETWORK / RESOURCE TUNING
# =============================================================================
CS_MAIL_BACKEND_SUBNET=172.29.40.0/24
CS_MAIL_BACKEND_GATEWAY=172.29.40.1
CS_MAIL_TRUSTED_PROXY_IPS=172.29.40.10,172.29.40.11
CS_MAIL_DB_MEMORY_LIMIT=1g
CS_MAIL_DB_CPU_LIMIT=1.0
CS_MAIL_API_MEMORY_LIMIT=1g
CS_MAIL_API_CPU_LIMIT=1.0

# =============================================================================
# 5. EXISTING SHARED STALWART PROVIDER
# =============================================================================
# REQUIRED OPERATOR INPUT: existing Docker network containing Stalwart.
# Find it with: docker network ls
CS_MAIL_SHARED_PROVIDER_NETWORK=
# Shared Messenger edge network. Its Nginx container owns public 80/443.
CS_MAIL_SHARED_WEB_NETWORK=cs-messenger_messenger
CS_MAIL_WEB_PROXY_MODE=messenger
CS_MAIL_SHARED_EDGE_CONTAINER=cs-messenger-nginx-1
# These defaults assume the existing Stalwart container is resolvable as
# "stalwart" on that Docker network. Change only if its network alias differs.
CS_MAIL_MAIL_ADMIN_URL=http://stalwart:8080/
CS_MAIL_MAIL_ADMIN_USERNAME=admin
# REQUIRED OPERATOR INPUT: dedicated least-privilege Stalwart management token.
CS_MAIL_MAIL_ADMIN_TOKEN=
# Optional legacy Basic-auth secret. Keep blank when the token above is used.
CS_MAIL_MAIL_ADMIN_SECRET=
# REQUIRED OPERATOR INPUT: Stalwart JMAP service principal and secret.
CS_MAIL_MAIL_JMAP_USERNAME=
CS_MAIL_MAIL_JMAP_SECRET=
CS_MAIL_MAIL_REQUEST_TIMEOUT_SECS=10
CS_MAIL_MAIL_READ_RETRIES=2
CS_MAIL_MAIL_RETRY_BASE_MS=150
CS_MAIL_PROVIDER_NAMESPACE=cs-mail
CS_MAIL_MAIL_DEFAULT_DOMAIN=crescentsphere.com

# API -> Stalwart relay over the private shared-provider Docker network.
CS_MAIL_SMTP_HOST=smtp.crescentsphere.com
CS_MAIL_SMTP_PORT=465
# Dedicated Stalwart submission identity. Port 465 uses verified implicit TLS.
CS_MAIL_SMTP_USERNAME=
CS_MAIL_SMTP_PASSWORD=
CS_MAIL_SMTP_TIMEOUT_SECS=30

# =============================================================================
# 6. PUBLIC MAIL CLIENT / DELIVERY IDENTITY
# =============================================================================
# Existing DNS-only A record and VPS PTR/rDNS identity supplied by the operator.
CS_MAIL_CLIENT_HOST=smtp.crescentsphere.com
CS_MAIL_CLIENT_IMAP_PORT=993
CS_MAIL_CLIENT_SMTP_PORT=465
CS_MAIL_CLIENT_MAX_APP_PASSWORDS=5
CS_MAIL_EXPECTED_PTR=smtp.crescentsphere.com

# =============================================================================
# 7. BACKGROUND WORKERS / IMPORTS / ATTACHMENTS
# =============================================================================
CS_MAIL_IMPORT_MAX_BYTES=2147483648
CS_MAIL_IMPORT_MESSAGE_MAX_BYTES=52428800
CS_MAIL_IMPORT_POLL_SECS=5
CS_MAIL_IMPORT_LEASE_SECS=900
CS_MAIL_REALTIME_POLL_SECS=2
CS_MAIL_REALTIME_LEASE_SECS=60
CS_MAIL_REALTIME_BATCH_SIZE=20
CS_MAIL_REALTIME_EVENT_RETENTION_SECS=604800
CS_MAIL_PROVISIONING_POLL_SECS=2
CS_MAIL_PROVISIONING_LEASE_SECS=120
CS_MAIL_PROVISIONING_RETRY_BASE_SECS=5
CS_MAIL_PROVISIONING_RECONCILE_SECS=300
CS_MAIL_PROVISIONING_MAX_ATTEMPTS=12
CS_MAIL_PROVISIONING_BATCH_SIZE=10
CS_MAIL_SCHEDULE_POLL_SECS=5
CS_MAIL_SCHEDULE_LEASE_SECS=300
CS_MAIL_SCHEDULE_RETRY_BASE_SECS=15
CS_MAIL_SCHEDULE_MAX_ATTEMPTS=12
CS_MAIL_SCHEDULE_BATCH_SIZE=20
CS_MAIL_ATTACHMENT_STORE_DIR=/srv/attachments
CS_MAIL_ATTACHMENT_STAGING_QUOTA_BYTES=1073741824
CS_MAIL_ATTACHMENT_UPLOAD_TTL_SECS=86400
CS_MAIL_ATTACHMENT_DRAFT_TTL_SECS=2592000
CS_MAIL_ATTACHMENT_CONSUMED_GRACE_SECS=3600
CS_MAIL_ATTACHMENT_CLEANUP_SECS=900

# =============================================================================
# 8. BILLING / ACCEPTANCE-TEST POLICY
# =============================================================================
# Only enable instant activation temporarily for isolated acceptance tests.
CS_MAIL_BILLING_INSTANT_ACTIVATION=false

# =============================================================================
# 9. MONITORING / BACKUP / RELEASE POLICY
# =============================================================================
CS_MAIL_KEEP_RELEASES=5
CS_MAIL_BACKUP_DIR=/opt/backups/cs-mail
CS_MAIL_BACKUP_RETENTION_DAYS=30
CS_MAIL_ALERT_WEBHOOK_FILE=/opt/cs-mail/secrets/alert-webhook-url
CS_MAIL_CERT_REPORT_DIR=/opt/cs-mail/certifications
CS_MAIL_CERT_DOMAIN=crescentsphere.com
CS_MAIL_DKIM_SELECTOR=default

# Deployment identity is generated by deploy.sh in
# /opt/cs-mail/runtime/current.env. Do not manually maintain build hashes here.
