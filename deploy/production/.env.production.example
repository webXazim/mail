# CS Mail production environment — GitHub/VPS deployment contract.
# Install as /opt/cs-mail/.env.production, owner root, mode 600.
POSTGRES_PASSWORD=
CS_MAIL_JWT_SECRET=
CS_MAIL_DELIVERY_EVENT_SECRET=
CS_MAIL_PROVISIONING_KEY=
CS_MAIL_TOTP_KEY=

CS_MAIL_PUBLIC_ORIGIN=https://mail.crescentsphere.com
CS_MAIL_CORS_ORIGINS=https://mail.crescentsphere.com
CS_MAIL_API_HOST_PORT=18080
CS_MAIL_BACKEND_SUBNET=172.29.40.0/24
CS_MAIL_BACKEND_GATEWAY=172.29.40.1
CS_MAIL_TRUSTED_PROXY_IPS=172.29.40.1

# Existing Stalwart network/service from the developer-mailer deployment.
# Find it with: docker network ls
CS_MAIL_SHARED_PROVIDER_NETWORK=
CS_MAIL_MAIL_ADMIN_URL=http://stalwart:8080/
CS_MAIL_MAIL_ADMIN_TOKEN=
CS_MAIL_MAIL_ADMIN_USERNAME=admin
# Keep Basic management secret empty when a scoped token is available.
CS_MAIL_MAIL_ADMIN_SECRET=
CS_MAIL_MAIL_JMAP_USERNAME=
CS_MAIL_MAIL_JMAP_SECRET=
CS_MAIL_SMTP_HOST=stalwart
CS_MAIL_SMTP_PORT=25
CS_MAIL_SMTP_USERNAME=
CS_MAIL_SMTP_PASSWORD=

# Immutable provider ownership namespace. Migration 0034 persists `cs-mail`.
CS_MAIL_PROVIDER_NAMESPACE=cs-mail
CS_MAIL_MAIL_DEFAULT_DOMAIN=crescentsphere.com
CS_MAIL_CLIENT_HOST=mail.crescentsphere.com
CS_MAIL_CLIENT_IMAP_PORT=993
CS_MAIL_CLIENT_SMTP_PORT=587

# Resource envelopes; tune only after measuring the VPS.
CS_MAIL_DB_MEMORY_LIMIT=1g
CS_MAIL_DB_CPU_LIMIT=1.0
CS_MAIL_API_MEMORY_LIMIT=1g
CS_MAIL_API_CPU_LIMIT=1.0
CS_MAIL_DB_MAX_CONNECTIONS=10
CS_MAIL_KEEP_RELEASES=5
CS_MAIL_BACKUP_RETENTION_DAYS=30
# Deployment identity is generated automatically by deploy.sh and stored in
# /opt/cs-mail/runtime/current.env. Do not hand-maintain release hashes here.
CS_MAIL_CERT_DOMAIN=crescentsphere.com
CS_MAIL_DKIM_SELECTOR=default
CS_MAIL_EXPECTED_PTR=mail.crescentsphere.com
CS_MAIL_CERT_REPORT_DIR=/opt/cs-mail/certifications

# Monitoring receiver secret. Create this file root-owned, mode 600, with one
# HTTPS webhook URL (Slack-compatible relay, custom ops intake, etc.). The URL
# is mounted read-only into Alertmanager and is never committed to this repo.
CS_MAIL_ALERT_WEBHOOK_FILE=/opt/cs-mail/secrets/alert-webhook-url

# Acceptance-testing policy: ordering activates the plan immediately while invoice payment remains due.
# Set false before accepting real public payments.
CS_MAIL_BILLING_INSTANT_ACTIVATION=true
