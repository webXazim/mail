# CS Mail production launch-certification secrets.
# Copy to /opt/cs-mail/.env.certification, owner root, chmod 600.
# Do not reuse owner/admin production accounts. Use two disposable certification
# users in DIFFERENT businesses and dedicated app passwords that are revoked
# immediately after certification.

CS_MAIL_CERT_USER_A_EMAIL=
CS_MAIL_CERT_USER_A_PASSWORD=
CS_MAIL_CERT_USER_B_EMAIL=
CS_MAIL_CERT_USER_B_PASSWORD=

CS_MAIL_CERT_IMAP_A_USER=
CS_MAIL_CERT_IMAP_A_APP_PASSWORD=
CS_MAIL_CERT_IMAP_B_USER=
CS_MAIL_CERT_IMAP_B_APP_PASSWORD=

# Safe external RCPT used only up to SMTP RCPT TO. The certifier NEVER sends DATA
# during the no-open-relay probe.
CS_MAIL_CERT_EXTERNAL_RCPT=relay-probe@example.net

# Read-only concurrency probe. Tune only if the VPS has a documented lower gate.
CS_MAIL_CERT_LOAD_REQUESTS=200
CS_MAIL_CERT_LOAD_CONCURRENCY=20
CS_MAIL_CERT_LOAD_P95_MS=2000
