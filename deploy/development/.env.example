# CS Mail deployment secrets (read by docker-compose.yml).
# Copy to .env and fill in real values — never commit the real file.

# 32+ byte HS256 secret for JWT signing/verification.
# Generate: openssl rand -base64 48
CS_MAIL_JWT_SECRET=

# Upgrade 25 provider delivery-event HMAC secret. Use a separate random 32+
# character value. Leave empty to disable /api/internal/delivery-events.
CS_MAIL_DELIVERY_EVENT_SECRET=

# Postgres password for the `csmail` database role. Use a strong random password.
POSTGRES_PASSWORD=

# Public origin the frontend is served from (used by CORS + auth email links).
CS_MAIL_PUBLIC_ORIGIN=http://localhost:5174
CS_MAIL_CORS_ORIGINS=http://localhost:5174

# Auth lifecycle defaults (safe unless overridden):
#   CS_MAIL_REQUIRE_VERIFICATION=true   # email verification before sign-in
#   CS_MAIL_DEV_RETURN_TOKEN_LINKS=false    # MUST remain false in production
#   CS_MAIL_COOKIE_SECURE=true         # true once TLS is on
#   CS_MAIL_JWT_ACCESS_TTL_SECS=900
#   CS_MAIL_JWT_REFRESH_TTL_SECS=2592000

# Durable multi-instance realtime (Upgrade 15): PostgreSQL event replay +
# leased JMAP change watchers. Defaults are production-safe starting points.
# CS_MAIL_REALTIME_POLL_SECS=2
# CS_MAIL_REALTIME_LEASE_SECS=60
# CS_MAIL_REALTIME_BATCH_SIZE=20
# CS_MAIL_REALTIME_EVENT_RETENTION_SECS=604800  # 7 days

# Upgrade 26 external mail clients + durable MBOX import. The public client
# hostname is advertised in settings/autoconfig; expose 993/587 with valid TLS
# only after the Upgrade 27 network/firewall gate is complete.
CS_MAIL_CLIENT_HOST=mail.crescentsphere.com
# CS_MAIL_CLIENT_IMAP_PORT=993
# CS_MAIL_CLIENT_SMTP_PORT=587
# CS_MAIL_CLIENT_MAX_APP_PASSWORDS=5
# CS_MAIL_IMPORT_MAX_BYTES=2147483648
# CS_MAIL_IMPORT_MESSAGE_MAX_BYTES=52428800
# CS_MAIL_IMPORT_POLL_SECS=5
# CS_MAIL_IMPORT_LEASE_SECS=900

# Stalwart mail service (WS2). The root compose is local/dev; Upgrade 27 production uses deploy/production/docker-compose.yml and an EXISTING shared Stalwart.
# Bootstrap/dev Basic-auth secret; required by docker-compose for the initial admin.
CS_MAIL_MAIL_ADMIN_PASSWORD=
#   CS_MAIL_MAIL_ADMIN_TOKEN=          # preferred production management API token
#   CS_MAIL_MAIL_JMAP_USERNAME=        # privileged JMAP-mail service user (defaults admin)
#   CS_MAIL_MAIL_JMAP_SECRET=          # password/app password for JMAP mail access
#   CS_MAIL_MAIL_DEFAULT_DOMAIN=       # protected platform domain (default crescentsphere.com)
#   CS_MAIL_PROVIDER_NAMESPACE=cs-mail # immutable shared-provider ownership namespace
#   CS_MAIL_MAIL_REQUEST_TIMEOUT_SECS=10
#   CS_MAIL_MAIL_READ_RETRIES=2        # retries read-only JMAP calls only
#   CS_MAIL_MAIL_RETRY_BASE_MS=150

# Durable PostgreSQL -> Stalwart provisioning queue (Upgrade 03).
# Use an independent 32+ character random secret in production.
# Generate: openssl rand -base64 48
CS_MAIL_PROVISIONING_KEY=
# Separate 32+ character secret for TOTP enrollment encryption.
# Generate independently: openssl rand -base64 48
CS_MAIL_TOTP_KEY=
# Optional worker tuning; defaults shown below.
# CS_MAIL_PROVISIONING_POLL_SECS=2
# CS_MAIL_PROVISIONING_LEASE_SECS=120
# CS_MAIL_PROVISIONING_RETRY_BASE_SECS=5
# CS_MAIL_PROVISIONING_RECONCILE_SECS=300
# CS_MAIL_PROVISIONING_MAX_ATTEMPTS=12
# CS_MAIL_PROVISIONING_BATCH_SIZE=10

# Durable scheduled-send worker (safe across multiple API replicas)
# CS_MAIL_SCHEDULE_POLL_SECS=5
# CS_MAIL_SCHEDULE_LEASE_SECS=300
# CS_MAIL_SCHEDULE_RETRY_BASE_SECS=15
# CS_MAIL_SCHEDULE_MAX_ATTEMPTS=12
# CS_MAIL_SCHEDULE_BATCH_SIZE=20


# Staged outbound attachment storage (Upgrade 07).
# The Docker stack persists /srv/attachments in the api-attachments volume.
# CS_MAIL_ATTACHMENT_STORE_DIR=/srv/attachments
# CS_MAIL_ATTACHMENT_STAGING_QUOTA_BYTES=1073741824  # per-user staged bytes
# CS_MAIL_ATTACHMENT_UPLOAD_TTL_SECS=86400           # unattached uploads
# CS_MAIL_ATTACHMENT_DRAFT_TTL_SECS=2592000          # draft protection (30 days)
# CS_MAIL_ATTACHMENT_CONSUMED_GRACE_SECS=3600        # post-send/cancel cleanup grace
# CS_MAIL_ATTACHMENT_CLEANUP_SECS=900

# Stalwart provider ceilings used by the local Stalwart bootstrap procedure.
# 100 MiB is the CS Mail product ceiling; the message ceiling is higher to
# allow for MIME/base64 expansion during SMTP submission.
# CS_MAIL_MAIL_MAX_UPLOAD_BYTES=104857600
# CS_MAIL_MAIL_MAX_ATTACHMENT_BYTES=104857600
# CS_MAIL_MAIL_MAX_MESSAGE_BYTES=167772160

# Only these TCP peers may supply X-Real-IP/X-Forwarded-For. Keep this to the
# actual reverse-proxy addresses; direct clients cannot spoof rate-limit keys.
CS_MAIL_TRUSTED_PROXY_IPS=127.0.0.1,::1
CS_MAIL_LOG_FORMAT=json

# Upgrade 29 testing mode: ordering activates the plan immediately while invoice payment remains due.
# Set false before accepting real public payments.
CS_MAIL_BILLING_INSTANT_ACTIVATION=true
