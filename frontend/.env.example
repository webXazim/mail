# Harbor Mail frontend configuration

# Fully client-side demo mode. When enabled, login/register fall back to a
# fabricated local session if the backend is unreachable, and every service
# reads from localStorage. ONLY set this to true in an uncommitted local .env
# for offline development.
#
# The production build must never enter demo mode: leave VITE_DEMO_MODE
# unset or false in every deployed environment.
VITE_DEMO_MODE=false