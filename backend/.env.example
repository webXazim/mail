# Harbor Mail backend configuration
# Every value is read once at boot in src/config.rs. Required vars
# (HARBOR_DATABASE_URL, HARBOR_JWT_SECRET) fail-fast when missing; the rest
# fall back to local-development defaults. Copy to .env next to
# backend/Dockerfile or set in docker-compose.

# --- Server ---
HARBOR_LISTEN_ADDR=0.0.0.0:8080
HARBOR_PUBLIC_ORIGIN=http://mail.crescentsphere.com
# Comma-separated. Empty -> falls back to HARBOR_PUBLIC_ORIGIN.
HARBOR_CORS_ORIGINS=http://localhost:5174,http://mail.crescentsphere.com

# --- Database (Postgres) ---
# Metadata only: users, sessions, contacts, calendar, settings(JSONB), aliases,
# audit log. Mailbox content lives in the external mail store, not here.
HARBOR_DATABASE_URL=postgres://harbor:harbor@db:5432/harbor
HARBOR_DB_MAX_CONNECTIONS=10

# --- Auth / sessions ---
# HS256 JWT secret: use 32+ random bytes in production, sourced from your VPS
# secret store, never committed.
HARBOR_JWT_SECRET=change-me-in-prod
HARBOR_JWT_ACCESS_TTL_SECS=900
HARBOR_JWT_REFRESH_TTL_SECS=2592000
# Require email verification before sign-in (recommended for prod). Disable
# only for local/demo stacks.
HARBOR_REQUIRE_VERIFICATION=true
# Echo the verification/reset link back in the API response (dev only). Must be
# 0 in production — the link goes through email (SMTP bridge, WS2).
HARBOR_DEV_RETURN_TOKEN_LINKS=1
# Add Secure flag to the refresh-session cookie. Must be true once TLS is on.
HARBOR_COOKIE_SECURE=false

# --- Mail provisioning bridge (Stalwart, WS2) ---
# Empty HARBOR_MAIL_ADMIN_URL disables mailbox creation on signup (metadatabase
# users still work, but there is no real mailbox to log into).
HARBOR_MAIL_ADMIN_URL=http://mail:8080/
HARBOR_MAIL_ADMIN_USERNAME=admin
# Same value as compose STALWART_RECOVERY_ADMIN password (that account is the
# provisioning principal after bootstrap).
HARBOR_MAIL_ADMIN_SECRET=HarborDevMail!1
# Accounts are provisioned only under this domain (Stalwart defaultDomain).
HARBOR_MAIL_DEFAULT_DOMAIN=crescentsphere.com
# Mailbox disk quota in bytes for new accounts (default 2 GiB).
HARBOR_MAIL_ACCOUNT_QUOTA_BYTES=2147483648