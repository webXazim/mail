# CS Mail backend configuration
# Every value is read once at boot in src/config.rs. Required vars
# (CS_MAIL_DATABASE_URL, CS_MAIL_JWT_SECRET) fail-fast when missing; the rest
# fall back to local-development defaults. Copy to .env next to
# backend/Dockerfile or set in docker-compose.

# --- Server ---
CS_MAIL_LISTEN_ADDR=0.0.0.0:8080
CS_MAIL_PUBLIC_ORIGIN=https://mail.crescentsphere.com
# Comma-separated. Empty -> falls back to CS_MAIL_PUBLIC_ORIGIN.
CS_MAIL_CORS_ORIGINS=https://mail.crescentsphere.com

# --- Database (Postgres) ---
# Metadata only: users, sessions, contacts, calendar, settings(JSONB), aliases,
# audit log. Mailbox content lives in the external mail store, not here.
CS_MAIL_DATABASE_URL=
CS_MAIL_DB_MAX_CONNECTIONS=10

# --- Auth / sessions ---
# HS256 JWT secret: use 32+ random bytes in production, sourced from your VPS
# secret store, never committed.
CS_MAIL_JWT_SECRET=

# Upgrade 25 provider delivery-event HMAC secret. Use a separate random 32+
# character value. Leave empty to disable /api/internal/delivery-events.
CS_MAIL_DELIVERY_EVENT_SECRET=
CS_MAIL_JWT_ACCESS_TTL_SECS=900
CS_MAIL_JWT_REFRESH_TTL_SECS=2592000

# --- Durable realtime / multi-instance replay (Upgrade 15) ---
CS_MAIL_REALTIME_POLL_SECS=2
CS_MAIL_REALTIME_LEASE_SECS=60
CS_MAIL_REALTIME_BATCH_SIZE=20
CS_MAIL_REALTIME_EVENT_RETENTION_SECS=604800
# Require email verification before sign-in (recommended for prod). Disable
# only for local/demo stacks.
CS_MAIL_REQUIRE_VERIFICATION=true
# Echo the verification/reset link back in the API response (dev only). Must be
# 0 in production — the link goes through email (SMTP bridge, WS2).
CS_MAIL_DEV_RETURN_TOKEN_LINKS=false
# Add Secure flag to the refresh-session cookie. Must be true once TLS is on.
CS_MAIL_COOKIE_SECURE=true
CS_MAIL_TRUSTED_PROXY_IPS=127.0.0.1,::1
CS_MAIL_LOG_FORMAT=json

# --- Mail provisioning bridge (Stalwart, WS2) ---
# Empty CS_MAIL_MAIL_ADMIN_URL disables mailbox creation on signup (metadatabase
# users still work, but there is no real mailbox to log into).
CS_MAIL_MAIL_ADMIN_URL=http://mail:8080/
CS_MAIL_MAIL_ADMIN_USERNAME=admin
# Same value as compose STALWART_RECOVERY_ADMIN password (that account is the
# provisioning principal after bootstrap).
CS_MAIL_MAIL_ADMIN_SECRET=
# Accounts are provisioned only under this domain (Stalwart defaultDomain).
CS_MAIL_MAIL_DEFAULT_DOMAIN=crescentsphere.com
# Shared-provider ownership namespace. Upgrade 27 persists this as `cs-mail`;
# changing it requires an explicit database/provider migration.
CS_MAIL_PROVIDER_NAMESPACE=cs-mail
# Preferred production management credential; API keys are management-only.
CS_MAIL_MAIL_ADMIN_TOKEN=
# Separate Basic-auth credential for privileged JMAP mail operations.
CS_MAIL_MAIL_JMAP_USERNAME=admin
CS_MAIL_MAIL_JMAP_SECRET=
CS_MAIL_MAIL_REQUEST_TIMEOUT_SECS=10
CS_MAIL_MAIL_READ_RETRIES=2
CS_MAIL_MAIL_RETRY_BASE_MS=150



# --- External mail clients + mailbox import (Upgrade 26) ---
CS_MAIL_CLIENT_HOST=mail.crescentsphere.com
CS_MAIL_CLIENT_IMAP_PORT=993
CS_MAIL_CLIENT_SMTP_PORT=587
CS_MAIL_CLIENT_MAX_APP_PASSWORDS=5
# Raw MBOX upload ceiling (2 GiB) and per-message safety ceiling (50 MiB).
CS_MAIL_IMPORT_MAX_BYTES=2147483648
CS_MAIL_IMPORT_MESSAGE_MAX_BYTES=52428800
CS_MAIL_IMPORT_POLL_SECS=5
CS_MAIL_IMPORT_LEASE_SECS=900

# --- Durable provisioning / reconciliation (Upgrade 03) ---
# Independent 32+ character random passphrase used by PostgreSQL pgcrypto to
# encrypt short-lived mailbox provisioning credentials in the job queue.
# Generate: openssl rand -base64 48
CS_MAIL_PROVISIONING_KEY=change-me-use-an-independent-random-secret
CS_MAIL_PROVISIONING_POLL_SECS=2
CS_MAIL_PROVISIONING_LEASE_SECS=120
CS_MAIL_PROVISIONING_RETRY_BASE_SECS=5
CS_MAIL_PROVISIONING_RECONCILE_SECS=300
CS_MAIL_PROVISIONING_MAX_ATTEMPTS=12
CS_MAIL_PROVISIONING_BATCH_SIZE=10


# --- Staged outbound attachments (Upgrade 07) ---
CS_MAIL_ATTACHMENT_STORE_DIR=/srv/attachments
CS_MAIL_ATTACHMENT_STAGING_QUOTA_BYTES=1073741824
CS_MAIL_ATTACHMENT_UPLOAD_TTL_SECS=86400
CS_MAIL_ATTACHMENT_DRAFT_TTL_SECS=2592000
CS_MAIL_ATTACHMENT_CONSUMED_GRACE_SECS=3600
CS_MAIL_ATTACHMENT_CLEANUP_SECS=900

# Upgrade 29 testing mode: ordering activates the plan immediately while invoice payment remains due.
# Set false before accepting real public payments.
CS_MAIL_BILLING_INSTANT_ACTIVATION=true
